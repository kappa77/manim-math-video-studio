  "styles": {
    "warm-teacher": {
      "label": "Warm teacher",
      "rate": "-3%",
      "pitch": "+0Hz",
      "description": "Clear, patient, slightly slower. The default for classroom and general explainers."
    },
    "calm-documentary": {
      "label": "Calm documentary",
      "rate": "-8%",
      "pitch": "-2Hz",
      "description": "Measured, low energy, authoritative. Good for long-form and history."
    },
    "energetic-explainer": {
      "label": "Energetic explainer",
      "rate": "+8%",
      "pitch": "+2Hz",
      "description": "Faster, brighter, more animated. Good for shorts and young audiences."
    },
    "authoritative-lecturer": {
      "label": "Authoritative lecturer",
      "rate": "-5%",
      "pitch": "-3Hz",
      "description": "Precise, deliberate, minimal hype. Good for proofs and technical material."
    },
    "friendly-conversational": {
      "label": "Friendly conversational",
      "rate": "+3%",
      "pitch": "+0Hz",
      "description": "Informal, close, conversational. Good for podcast-style episodes."
