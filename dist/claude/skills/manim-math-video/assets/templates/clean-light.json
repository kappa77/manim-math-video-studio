{
  "schema_version": 1,
  "id": "clean-light",
  "name": "Clarity",
  "version": "1.0.0",
  "description": "Warm off-white canvas, dark ink, cobalt and amber accents. Precise, accessible, graph-first.",
  "best_for": [
    "general explainers",
    "classroom material",
    "graph-led episodes",
    "accessibility-first work",
    "daylight viewing"
  ],
  "aspect_ratio": "16:9",
  "background": "#F7F5F0",
  "surface": "#FFFFFF",
  "ink": "#1F2937",
  "muted": "#6B7280",
  "roles": {
    "primary": "#2563EB",
    "secondary": "#D97706",
    "success": "#059669",
    "warning": "#D97706",
    "danger": "#DC2626",
    "grid": "#D1D5DB",
    "axis": "#6B7280"
  },
  "fonts": {
    "heading": ["Inter", "Segoe UI", "DejaVu Sans"],
    "body": ["Inter", "Segoe UI", "DejaVu Sans"],
    "mono": ["JetBrains Mono", "Consolas", "DejaVu Sans Mono"]
  },
  "sizes": {
    "title": 58,
    "heading": 44,
    "body": 30,
    "bullet": 30,
    "caption": 24,
    "equation": 46,
    "label": 22,
    "tick": 18
  },
  "layout": {
    "margin": 0.7,
    "heading_top_buff": 0.45,
    "graph_width": 9.6,
    "graph_height": 5.0,
    "graph_center_y": -0.75,
    "text_max_width": 11.5,
    "bullet_spacing": 0.35,
    "column_gap": 0.9
  },
  "graph": {
    "stroke_width": 5,
    "axis_stroke_width": 2.5,
    "tick_size": 18,
    "label_size": 22,
    "tick_label_buff": 0.12,
    "area_opacity": 0.22,
    "dot_radius": 0.07,
    "grid_opacity": 0.25
  },
  "motion": {
    "style": "write",
    "transition": "fade",
    "transition_time": 0.28,
    "default_hold": 0.25,
    "reveal_lag": 0.18
  },
  "captions": {
    "enabled": true,
    "max_chars": 84,
    "tail_pad": 0.15
  },
  "story": {
    "beats": ["title", "section", "graph", "equation", "bullets", "compare", "recap", "outro"],
    "words_per_minute": 145
  }
}
