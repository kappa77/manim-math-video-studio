{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/manim-math-video/brief.schema.json",
  "title": "Math video episode brief",
  "type": "object",
  "required": ["schema_version", "series", "episode", "output", "accuracy"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill_version": { "type": "string" },
    "created_at": { "type": "string" },
    "series": {
      "type": "object",
      "required": ["title", "slug", "season", "episode_number", "template", "premise", "audience"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "season": { "type": "integer", "minimum": 1 },
        "episode_number": { "type": "integer", "minimum": 1 },
        "template": { "type": "string", "minLength": 1 },
        "premise": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "visual_motif": { "type": ["string", "null"] },
        "consistency_note": { "type": ["string", "null"] },
        "defaults": {
          "type": "object",
          "properties": {
            "quality": { "enum": ["draft", "standard", "high", "4k"] },
            "language": { "type": "string" },
            "voice": { "$ref": "#/$defs/voice" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "episode": {
      "type": "object",
      "required": [
        "title",
        "slug",
        "thesis",
        "audience",
        "prerequisites",
        "goals",
        "rigor",
        "tone",
        "target_duration_seconds",
        "platform",
        "aspect_ratio",
        "key_points",
        "misconceptions",
        "visuals"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "thesis": { "type": "string", "minLength": 1 },
        "question": { "type": "string" },
        "audience": { "type": "string", "minLength": 1 },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "goals": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "rigor": { "enum": ["intuition", "sketch", "proof", "derivation"] },
        "tone": { "type": "string" },
        "target_duration_seconds": { "type": "integer", "minimum": 30, "maximum": 7200 },
        "platform": { "type": "string" },
        "aspect_ratio": { "enum": ["16:9", "9:16", "1:1", "4:3"] },
        "key_points": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "misconceptions": { "type": "array", "items": { "type": "string" } },
        "visuals": { "type": "array", "items": { "type": "string" } },
        "next_teaser": { "type": ["string", "null"] },
        "previous_recap": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "required": ["quality", "language", "subtitle_language", "captions", "latex_fallback", "voice"],
      "properties": {
        "quality": { "enum": ["draft", "standard", "high", "4k"] },
        "language": { "type": "string", "minLength": 2 },
        "subtitle_language": { "type": "string", "minLength": 2 },
        "captions": { "type": "boolean" },
        "latex_fallback": { "type": "boolean" },
        "music": { "type": ["string", "null"] },
        "music_gain_db": { "type": "number", "maximum": 0, "minimum": -60 },
        "voice": { "$ref": "#/$defs/voice" }
      },
      "additionalProperties": true
    },
    "accuracy": {
      "type": "object",
      "required": ["notation", "pronunciations", "sources", "claims_to_verify"],
      "properties": {
        "notation": { "type": "array", "items": { "type": "string" } },
        "conventions": { "type": "string" },
        "pronunciations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "sources": { "type": "array", "items": { "type": "string" } },
        "claims_to_verify": { "type": "array", "items": { "type": "string" } },
        "reviewed_by": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "voice": {
      "type": "object",
      "required": ["provider", "id", "style", "rate", "pitch"],
      "properties": {
        "provider": { "enum": ["edge", "piper", "custom", "none"] },
        "id": { "type": "string", "minLength": 1 },
        "style": { "type": "string" },
        "rate": { "type": "string" },
        "pitch": { "type": "string" },
        "volume": { "type": "string" },
        "command": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "piper_model": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
